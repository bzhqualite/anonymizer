# Réseau Solana : utilisez devnet tant que tout n'est pas validé
SOLANA_RPC_URL=https://api.devnet.solana.com
PORT=3000

# Clé AES-256 (64 caractères hex) qui chiffre les clés privées des adresses de dépôt en base.
# Générez-la avec : npm run keygen
MASTER_KEY=

# Wallet "pool" qui reçoit les dépôts et effectue les paiements (clé secrète base58).
# Générez-le avec : npm run keygen
POOL_SECRET_KEY=

# Adresse où la commission est reversée à la fin de chaque ordre (optionnel : sinon elle reste dans le pool)
TREASURY_ADDRESS=

# Commission en points de base (100 = 1 %)
FEE_BPS=100

# Limites par ordre, en SOL
MIN_DEPOSIT_SOL=0.1
MAX_DEPOSIT_SOL=100
MAX_DESTINATIONS=5

# Durée de validité d'un ordre sans dépôt (minutes)
ORDER_TTL_MINUTES=60

# Délai aléatoire max entre la réception et chaque paiement (minutes). 0 = immédiat.
MAX_PAYOUT_DELAY_MINUTES=30

# Fichier listant des adresses bloquées (une par ligne, ex. listes de sanctions OFAC/UE)
BLOCKLIST_FILE=blocklist.txt

DB_PATH=data/anonymizer.db
